Stephen Tobolowsky, and Rosalind Chao. They are joined by Julia Butters, Sophia Hammons, Manny Jacinto, and Maitreyi Ramakrishnan.","images":{"assets":{"catalog_poster_image":{"base_url":"https://lumiere-a.akamaihd.net/v1/images/p_disneymovies_freakierfriday_pay1sunrise_poster_652ab061.jpeg","base_url_https":"https://lumiere-a.akamaihd.net/v1/images/p_disneymovies_freakierfriday_pay1sunrise_poster_652ab061.jpeg","api_params":{"region":"0,0,540,810"},"cdn_url":"https://lumiere-a.akamaihd.net/v1/images/p_disneymovies_freakierfriday_pay1sunrise_poster_652ab061.jpeg?region=0%2C0%2C540%2C810","cdn_url_https":"https://lumiere-a.akamaihd.net/v1/images/p_disneymovies_freakierfriday_pay1sunrise_poster_652ab061.jpeg?region=0%2C0%2C540%2C810","alt_text":"(L-R) Lindsay Lohan as Anna Coleman and Jamie Lee Curtis as Tess Coleman in Disney's FREAKIER FRIDAY. | Now available | Disney+ | Disney | Freakier Friday | movie poster"},"poster_image":{"base_url":"https://lumiere-a.akamaihd.net/v1/images/p_disneymovies_freakierfriday_pay1sunrise_poster_652ab061.jpeg","base_url_https":"https://lumiere-a.akamaihd.net/v1/images/p_disneymovies_freakierfriday_pay1sunrise_poster_652ab061.jpeg","api_params":{"region":"0,0,540,810"},"cdn_url":"https://lumiere-a.akamaihd.net/v1/images/p_disneymovies_freakierfriday_pay1sunrise_poster_652ab061.jpeg?region=0%2C0%2C540%2C810","cdn_url_https":"https://lumiere-a.akamaihd.net/v1/images/p_disneymovies_freakierfriday_pay1sunrise_poster_652ab061.jpeg?region=0%2C0%2C540%2C810","alt_text":"(L-R) Lindsay Lohan as Anna Coleman and Jamie Lee Curtis as Tess Coleman in Disney's FREAKIER FRIDAY. | Now available | Disney+ | Disney | Freakier Friday | movie poster"},"logo_image":{"base_url":"https://lumiere-a.akamaihd.net/v1/images/p_disneymovies_freakierfriday_pay1sunrise_poster_652ab061.jpeg","base_url_https":"https://lumiere-a.akamaihd.net/v1/images/p_disneymovies_freakierfriday_pay1sunrise_poster_652ab061.jpeg","api_params":{"region":"0,0,540,810"},"cdn_url":"https